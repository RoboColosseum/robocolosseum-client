+    def get_feedback_snapshot(self):
+        """Copy the last complete bus sweep; never send a CAN command.
+
+        The timestamp is host receipt of a completed sweep, not a hardware clock
+        or a simultaneous sample of all motors. Repeated reads keep its sequence.
+        """
+        with self.state_lock:
+            return self._feedback_snapshot_locked()
+
+    def _feedback_snapshot_locked(self):
+        if self.state is None or self._feedback_monotonic_s is None:
+            raise RuntimeError('No complete motor feedback available')
+        return {
+                'sequence': self._feedback_sequence,
+                'received_monotonic_s': self._feedback_monotonic_s,
+                'running': bool(self.running),
+                'motor_ids': [state.id for state in self.state],
+                'position': [self._joint_position_real_to_sim_idx(self.absolute_positions[i], i)
+                             for i in range(len(self.state))],
+                'velocity': [state.velocity * self.motor_direction[i]
+                             for i, state in enumerate(self.state)],
+                'torque_nm': [state.torque * self.motor_direction[i]
+                              for i, state in enumerate(self.state)],
+            }
+
+    def _retain_feedback_locked(self):
+        # Opt-in numeric copies only; no FK, disk I/O, callback, CAN command or
+        # blocking queue operation is allowed on the motor feedback producer.
+        history = self._feedback_history
+        if history is not None:
+            if len(history) == history.maxlen:
+                self._feedback_history_dropped += 1
+            history.append(self._feedback_snapshot_locked())
+
+    def start_feedback_history(self, capacity=1024):
+        if not isinstance(capacity, int) or not 2 <= capacity <= 4096:
+            raise ValueError('Invalid feedback history capacity')
+        with self.state_lock:
+            if self._feedback_history is not None:
+                raise RuntimeError('Feedback history already active')
+            self._feedback_history = deque(maxlen=capacity)
+            self._feedback_history_dropped = 0
+            self._retain_feedback_locked()
+
+    def drain_feedback_history(self):
+        with self.state_lock:
+            if self._feedback_history is None:
+                raise RuntimeError('Feedback history not active')
+            rows = list(self._feedback_history)
+            self._feedback_history.clear()
+            return dict(rows=rows, dropped=self._feedback_history_dropped,
+                        running=bool(self.running))
+
+    def stop_feedback_history(self):
+        with self.state_lock:
+            self._feedback_history = None
 
